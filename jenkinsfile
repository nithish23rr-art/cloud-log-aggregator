pipeline {
    agent any

    environment {
        IMAGE_NAME = 'cloud-log-aggregator'
        CONTAINER_NAME = 'log-aggregator-app'
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                echo 'Checking out code from Git repository...'
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image for Cloud Log Aggregator...'
                sh "docker build -t ${IMAGE_NAME} ."
            }
        }

        stage('Stop Old Container') {
            steps {
                echo 'Checking for existing running containers...'
                sh "docker stop ${CONTAINER_NAME} || true"
                sh "docker rm ${CONTAINER_NAME} || true"
            }
        }

        stage('Run New Container') {
            steps {
                echo 'Deploying application inside Docker container...'
                sh "docker run -d -p 5000:5000 --name ${CONTAINER_NAME} ${IMAGE_NAME}"
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline executed successfully! App is live on port 5000.'
        }
        failure {
            echo 'CI/CD Pipeline failed during execution. Please check the logs.'
        }
    }
}